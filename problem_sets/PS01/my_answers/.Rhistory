ylab = "Per capita housing assistance")
plot(expenditure$Region, expenditure$Y,
main = "Comparing housing assistance by region",
xlab = "Region",
ylab = "Per capita housing assistance")
points(tapply(expenditure$Y, expenditure$Region, mean), col = "red", pch = 19)
